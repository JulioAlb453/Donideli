{
  "name": "donideli",
  "version": "0.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "ng": "ng",
    "serve": "node scripts/run-ng.mjs serve",
    "start": "node scripts/run-ng.mjs build && node scripts/render-spa-server.mjs",
    "build": "node scripts/run-ng.mjs build",
    "build:render": "node scripts/run-ng.mjs build --configuration=production-static",
    "start:render": "node scripts/render-spa-server.mjs",
    "watch": "node scripts/run-ng.mjs build --watch --configuration=development",
    "test": "ng test",
    "serve:ssr:donideli": "node dist/donideli/server/server.mjs"
  },
  "private": true,
  "packageManager": "pnpm",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.24",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}